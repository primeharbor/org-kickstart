resource "aws_notifications_notification_configuration" "primary_notification_config" {
  provider             = aws.security-account
  count                = var.user_notifications["enabled"] ? 1 : 0
  name                 = "primary-notification-config"
  description          = "Org-Kickstart Notification Configuration"
  aggregation_duration = var.user_notifications["aggregation_duration"]
}

resource "aws_notificationscontacts_email_contact" "primary_contact" {
  provider      = aws.security-account
  count         = var.user_notifications["enabled"] ? 1 : 0
  name          = var.user_notifications["contact_name"]
  email_address = var.user_notifications["contact_email"]
}

resource "aws_notifications_channel_association" "primary_notification_association" {
  provider                       = aws.security-account
  count                          = var.user_notifications["enabled"] ? 1 : 0
  arn                            = aws_notificationscontacts_email_contact.primary_contact[0].arn
  notification_configuration_arn = aws_notifications_notification_configuration.primary_notification_config[0].arn
}

resource "awscc_notifications_notification_hub" "primary_notification_hub" {
  provider = awscc.security-account
  count    = var.user_notifications["enabled"] ? 1 : 0
  region   = var.user_notifications["notification_hub_region"]
}